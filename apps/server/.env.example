# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://fxcryptoedge:fxcryptoedge@localhost:5432/fxcryptoedge?schema=public"

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:3000"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Google login (Sign in with Google / ID token flow — only the Client ID is needed,
# no secret or redirect URI). Create one at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""

# This server's own public base URL (no trailing slash) — used to build the
# Cashfree order's notify_url (webhook callback). Locally this can stay as
# the default below; in Render, set it to the API's onrender.com URL (or the
# custom API domain, if one is set up).
API_ORIGIN="http://localhost:4000"

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cashfree (sandbox test keys from https://merchant.cashfree.com — Developers > API Keys).
# Set CASHFREE_ENV=PRODUCTION only once live keys are in and the merchant
# account is fully activated; it defaults to sandbox otherwise so a
# half-configured env can never accidentally take a live payment.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="SANDBOX"

# Email (forgot-password links) — Resend API key from https://resend.com/api-keys.
# If unset, forgot-password requests are logged instead of emailed, so the rest
# of the app still runs fine without it. EMAIL_FROM defaults to Resend's shared
# testing address; once a domain is verified on Resend, set it to a real address
# like "Fx Crypto Edge <noreply@fxcryptoedge.in>".
RESEND_API_KEY=""
EMAIL_FROM=""
